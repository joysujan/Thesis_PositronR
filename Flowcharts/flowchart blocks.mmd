flowchart TD

  %% Phase 1 (Intake)
  subgraph G1["Phase 1 · Intake"]
    direction TB
    P1A["P1: Factors labeled"]:::p1
    P1B["P1: SEM-safe names"]:::p1
    P1C["P1: Ordered items (0–3/1–5)"]:::p1
    P1D["P1: K-1 dummies"]:::p1
  end

  %% Phase 2 (Measurement)
  subgraph G2["Phase 2 · Measurement"]
    direction TB
    P2A["P2: CFA/SEM spec (WLSMV/theta)"]:::p2
    P2B["P2: Core SEM fit + R²"]:::p2
    P2C["P2: MG invariance (thr+load)"]:::p2
    P2D["P2: Path equality tests (Δ)"]:::p2
    P2A --> P2B --> P2C --> P2D
  end

  %% Phase 3 (Structural)
  subgraph G3["Phase 3 · Structural"]
    direction TB
    P3A["P3: MI + design pruning"]:::p3
    P3B["P3: Extended SEM across imputations"]:::p3
    P3C["P3: D2 pooled estimates + scores"]:::p3
    P3A --> P3B --> P3C
  end

  %% Phase 4 (Profiling)
  subgraph G4["Phase 4 · Profiling"]
    direction TB
    P4A["P4: Load latents, z-score"]:::p4
    P4B["P4: PCA (PC1–2)"]:::p4
    P4C["P4: k-scan + silhouette"]:::p4
    P4D["P4: Final k-means + ARI"]:::p4
    P4E["P4: Profiles + descriptors"]:::p4
    P4A --> P4B --> P4C --> P4D --> P4E
  end

  %% Phase 5A (EFA+Network)
  subgraph G5A["Phase 5A · EFA + Network"]
    direction TB
    P5A1["5A: Polychoric PA (nfactors)"]:::p5a
    P5A2["5A: EFA (PA/oblimin) + flags"]:::p5a
    P5A3["5A: Domain shortlists"]:::p5a
    P5A1 --> P5A2 --> P5A3
  end

  %% Phase 5C (GRM Short Form)
  subgraph G5C["Phase 5C · GRM Short Form"]
    direction TB
    P5C0["5C: GRM 21 (a,b) + Q3"]:::p5c
    P5C1["5C: TIF + marginal reliability"]:::p5c
    P5C2["5C: Diagnostics + balanced drops"]:::p5c
    P5C4["5C: GRM 15 + overlays"]:::p5c
    P5C5["5C: EAP θ, SE; sum→θ map"]:::p5c
    P5C_CAL["5C: SEM calibration (θ→θ_cal)"]:::p5c
    P5C_ROC["5C: ROC ops (Youden, Sens≥0.80)"]:::p5c
    P5C0 --> P5C1 --> P5C2 --> P5C4 --> P5C5
  end

  %% Phase 5D (Packaging)
  subgraph G5D["Phase 5D · Packaging & Shipping"]
    direction TB
    P5D1["5D: Kit (model, linker, ROC, scripts)"]:::p5d
    P5D2["5D: score_shortform() (θ, SE → θ_cal, flag)"]:::p5d
    P5D3["5D: R pkg dasssf15 + validate"]:::p5d
    BI["Handoff: BI (θ/θ_cal + flag)"]:::p5d
    P5D1 --> P5D2 --> P5D3 --> BI
  end

  %% Interconnections across blocks
  P1A --> P2A
  P1B --> P2A
  P1C --> P2A
  P1D --> P3A

  P2B --> P3A
  P2B --> P4A

  P3C --> P4A
  P3C --> P5C_CAL

  P4E --> P5C_ROC

  P5A3 --> P5C2

  P5C5 --> P5D1
  P5C_CAL --> P5D1
  P5C_ROC --> P5D1

